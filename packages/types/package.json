{
	"name": "@evnt/types",
	"version": "0.2.0",
	"description": "Open Evnt Types for TypeScript",
	"keywords": [
		"event",
		"open evnt",
		"types",
		"typescript"
	],
	"homepage": "https://evnt.directory",
	"bugs": "https://github.com/openevnt/openevnt-js/issues",
	"license": "MIT",
	"author": "Open Evnt Contributors",
	"repository": {
		"type": "git",
		"url": "https://github.com/openevnt/openevnt-js.git",
		"directory": "packages/types"
	},
	"files": [
