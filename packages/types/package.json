			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:^",
		"typescript": "^6.0.3"
	}
